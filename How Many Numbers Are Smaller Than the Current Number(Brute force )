class Solution {
    public int[] smallerNumbersThanCurrent(int[] nums) {
         int n=nums.length;
         int[] arr=new int[n];
        for(int i=0;i<n;i++){
            int ct=0;
            for(int j=0;j<n;j++){
                if(nums[i]!=nums[j] && nums[i]>nums[j]){
                    ct++;
                }
            }
        arr[i]=ct;
        }
        return arr;
    }

} 
