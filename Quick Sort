package RecursionImp;

public class QuickSort {
    public static void quick(int[] arr, int si, int ei){
        if(si>=ei){
            return;
        }
        int pIdx=partition(arr,si,ei);
        quick(arr,si,pIdx-1);//left of pivot
        quick(arr,pIdx+1,ei);//right side of pivot

    }
    public static int partition(int[] arr, int si, int ei){
        //last element 
        int pivot=arr[ei];
        int i=si-1;// make place for element which is smaller than pivot element
        for(int j=si;j<ei;j++){
            if(arr[j]<pivot){
                i++;
                //swap
                int temp=arr[j];
                arr[j]=arr[i];
                arr[i]=temp;
            }
        }
        //swap
        i++;
                int temp=pivot;
                arr[ei]=arr[i];//pivot=arr[i]
                arr[i]=temp;

                return i;
            }

    
    public static void main(String[] args) {
        int[] arr={6,2,5,8,9,4};
        quick(arr,0,arr.length-1);

        //print
        for(int i=0;i<arr.length;i++){
            System.out.print(arr[i]+" ");
        }
    }
}
