class Solution {
    public boolean uniformArray(int[] nums1) {
        int n=nums1.length;
        int[] nums2 =new  int[n];
        int ct1=0; int ct2=0;
        for(int i=0;i<n;i++){
            if(nums1[i]%2==0){
                nums2[i]=nums1[i];
                ct1++;
                continue;
            }
            else{
                nums2[i]=nums1[i];
                ct2++;
            }
    }
    if(ct1==n|| ct2==n){
        return true;
    }
    else{
        for(int i=1;i<n;i++){
            nums2[i-1]=nums1[i-1]-nums1[i];
        
        if(nums2[i-1]%2 !=0){
            return true;
        }}
    }

        return false;
    }
}
