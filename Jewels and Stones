class Solution {
    
    public static int funct(char ch, String s){
        int ct=0;
    for(int i=0;i<s.length();i++){
        if(ch==s.charAt(i)){
            ct++;
        }
    }
    return ct;
    }
    public int numJewelsInStones(String jewels, String stones) {
        int val=0;
        for(int i=0;i<jewels.length(); i++){
            char ch=jewels.charAt(i);
            val=val+funct(ch,stones);
        }
        return val;
    }
}
