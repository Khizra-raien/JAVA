class Solution {
    public String[] createGrid(int m, int n) {
        char[][] grid = new char[m][n];
        String[] result = new String[m];
        for (int i = 0; i < m; i++) {
            for(int j=0;j<n;j++){
                grid[i][j] = '.';
            }
        }
        if(m==1 || n==1){
            for (int i = 0; i < m; i++) {
            result[i] = new String(grid[i]);
            }
        }
        
        
        for(int i=0;i<m;i++){
            for(int j=0;j<n;j++){
                if(i==0){
                    continue;
                }
                if(j==n-1){
                    continue;
                }
                else{
                    grid[i][j]='#';
                }
            }
        }
        for (int i = 0; i < m; i++) {
            result[i] = new String(grid[i]);
            }
        return result;
    }
}
