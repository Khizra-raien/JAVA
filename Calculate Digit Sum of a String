class Solution {
    public String digitSum(String s, int k) {

        while(s.length()>k){
    StringBuilder newStr = new StringBuilder();
    for (int i = 0; i < s.length(); i += k) {

        int end = Math.min(i + k, s.length());
        int sum = 0;

        for (int j = i; j < end; j++) {
            sum += Character.getNumericValue(s.charAt(j));
        }
        newStr.append(sum);
    }
    s = newStr.toString();
}

return s;
        
    }
}
