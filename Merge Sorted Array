class Solution {
    public void merge(int[] nums1, int m, int[] nums2, int n) {
        int idx1=m-1;
        int idx2=n-1;
        int pt=nums1.length-1;
        for(int i=0;i<m+n;i++){
            if(m>=0 && n==0){
                break;
            }
            if(idx1==-1){
                    for(int j=idx2;j>=0;j--){
                        nums1[pt]=nums2[j];
                        pt=pt-1;
                    }
                    break;
                }

            if(nums1[idx1]>nums2[idx2] ){
                nums1[pt]=nums1[idx1];
                idx1=idx1-1;
            }
            else{
                nums1[pt]=nums2[idx2];
                idx2=idx2-1;
                if(idx2==-1){
                    break;
                }
            }
            pt=pt-1;
        }

    }
}
