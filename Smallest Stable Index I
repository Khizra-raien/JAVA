class Solution {
    public int firstStableIndex(int[] nums, int k) {
        int n=nums.length;
        int max=Integer.MIN_VALUE;
       
        for(int i=0;i<n;i++){
             int min= Integer.MAX_VALUE;
            if(max<nums[i]){
                max=nums[i];
            }
            for(int j=i; j<n;j++){
                if(min>nums[j]){
                    min=nums[j];
                }
            }
            int result=max-min;
            if(result<=k){
                return i;
            }
        }
        return -1;
    }
}
