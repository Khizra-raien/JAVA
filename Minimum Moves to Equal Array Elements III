class Solution {
    public int minMoves(int[] nums) {
        int moves=0;
        int large=0;
        for(int i=0;i<nums.length;i++){
            if(nums[i]>large){
                large=nums[i];
            }
        }
        for(int i=0;i<nums.length;i++){
            moves=(large-nums[i])+moves;
        }
        return moves;
    }
}
