import java.util.*;
public class Main {
    public static void main(String[] args) {
         Scanner sc=new Scanner(System.in);
         int n=sc.nextInt();
         int sum=0;
         while(n>0){
            int lst=n%10;
            sum +=lst;
            n=n/10;
         }
         if(sum>10){
            System.out.println("YES");
         }
         else{
            System.out.println("NO");
         }
    }
}
