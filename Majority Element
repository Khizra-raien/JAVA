class Solution {
    public int majorityElement(int[] nums) {
        int n= nums.length;
      int var=nums[0];
      int ct=0;
      for(int i=0;i<n;i++){
        if(var==nums[i]){
            ct++;
        }
        else {
            ct--;
        }
        if(ct==0){
            var=nums[i];
            ct=1;
        }
      }
      return var;
    }
}
