class Solution {
    public List<Integer> findMissingElements(int[] nums) {
        List<Integer> arr= new ArrayList<>();
        int n=nums.length;
        int min=Integer.MAX_VALUE;
        int max=Integer.MIN_VALUE;
        for(int i=0; i<n;i++){
            if(max<nums[i]){
                max=nums[i];
            }
            if(min>nums[i]){
                min=nums[i];
            }
        }
        Arrays.sort(nums);
        
       for(int i=0;i<n;i++){
        if(nums[i] != min && min<=max ){
            arr.add(min);
            i--;
        }
        min++;
       }

        return arr;
    }
}
