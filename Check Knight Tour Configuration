class Solution {
    public static boolean isSafe(int[][] grid, int r, int c, int n, int expectval){
        if(r<0 || c<0 || r>=n || c>=n || grid[r][c] != expectval){
            return false;
        }
        if(expectval== (n*n)-1){
            return true;
        }
        //8 moves
        boolean ans1=isSafe(grid,r-2,c+1,n,expectval+1);
        boolean ans2=isSafe(grid,r-1,c+2,n,expectval+1);
        boolean ans3=isSafe(grid,r+1,c+2,n,expectval+1);
        boolean ans4=isSafe(grid,r+2,c+1,n,expectval+1);
        boolean ans5=isSafe(grid,r+2,c-1,n,expectval+1);
        boolean ans6=isSafe(grid,r+1,c-2,n,expectval+1);
        boolean ans7=isSafe(grid,r-1,c-2,n,expectval+1);
        boolean ans8=isSafe(grid,r-2,c-1,n,expectval+1);
        
        return ans1 || ans2 || ans3 || ans4 || ans5 || ans6 ||ans7 || ans8;
    }
    public boolean checkValidGrid(int[][] grid) {
        return isSafe(grid,0,0,grid.length,0);
    }
}
